# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Hetzner ---
# Create at: Hetzner Cloud Console > Security > API Tokens (Read & Write)
HETZNER_API_TOKEN=

# --- Tailscale ---
# Create at: Tailscale admin > Settings > Keys > Generate auth key
# Must be: Reusable, Ephemeral OFF, and tagged 'tag:server' so the node never expires.
# This key is how you get into every box you provision — there are no SSH keys.
TAILSCALE_AUTHKEY=
