# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Hetzner ---
# Create at: Hetzner Cloud Console > Security > API Tokens (Read & Write)
HETZNER_API_TOKEN=

# Name of your master SSH key as it appears in Hetzner > Security > SSH Keys
HETZNER_SSH_KEY_NAME=

# --- Tailscale ---
# Create at: Tailscale admin > Settings > Keys > Generate auth key
# Recommended: Reusable + Ephemeral OFF (persistent) so the node stays in your tailnet.
TAILSCALE_AUTHKEY=