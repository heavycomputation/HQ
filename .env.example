# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Hetzner ---
# Create at: Hetzner Cloud Console > Security > API Tokens (Read & Write)
HETZNER_API_TOKEN=

# Name of your master SSH key as it appears in Hetzner > Security > SSH Keys
HETZNER_SSH_KEY_NAME=

# Defaults for new servers (override per-run when provisioning)
HETZNER_SERVER_TYPE=cx23          # cx23 = 2 vCPU / 4GB x86 (cx22 is deprecated). cax11 = same specs on ARM, cheaper.
HETZNER_LOCATION=hel1             # hel1=Helsinki fsn1=Falkenstein nbg1=Nuremberg ash=Ashburn
HETZNER_IMAGE=ubuntu-24.04

# --- Tailscale ---
# Create at: Tailscale admin > Settings > Keys > Generate auth key
# Recommended: Reusable + Ephemeral OFF (persistent) so the node stays in your tailnet.
TAILSCALE_AUTHKEY=
